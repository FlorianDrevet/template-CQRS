{
  "realm": "template",
  "enabled": true,
  "displayName": "Template local development",
  "clients": [
    {
      "clientId": "template-api",
      "name": "Template API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "template-scalar",
      "name": "Template Scalar API reference",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:5257/*",
        "https://localhost:7246/*"
      ],
      "webOrigins": [
        "http://localhost:5257",
        "https://localhost:7246"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "template-api-audience"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "template-api-audience",
      "description": "Adds the API audience to access tokens issued for local development.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "template-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "template-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
